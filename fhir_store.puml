@startuml fhir_store

actor "FHIR Consumer/Source" as consumer

box "HAPI Integration Layer"
    participant "openFHIR HAPI Interceptor\n(this project)" as facade
    participant "HAPI FHIR DB" as hapi

end box

participant "openFHIR" as openfhir
participant "openEHR CDR" as cdr

consumer -> facade : Store FHIR Resource

facade -> hapi : PIX lookup — read Patient,\nfind EHR ID for target CDR

alt EHR ID not found
    facade -> cdr : POST /ehr (create new EHR)
    cdr --> facade : ehrId
    facade -> hapi : update Patient with new ehrId identifier
end

facade -> openfhir : POST /$toopenehr?format=canonical\n(FHIR Bundle as body)

openfhir --> facade : Parameters\n(composition = openEHR Composition,\noptional outcome = OperationOutcome)

facade -> facade : unwrap composition parameter,\nlog any outcome issues

facade -> cdr : POST /ehr/{{ehrId}}/composition

@enduml
