@startuml fhir_query

actor "FHIR Consumer/Source" as consumer

box "HAPI Integration Layer"
    participant "openFHIR HAPI Interceptor***REMOVED***n(this project)" as facade
    participant "HAPI FHIR DB" as hapi
end box

participant "openFHIR" as openfhir
participant "openEHR CDR" as cdr

consumer -> facade : FHIR Search Query***REMOVED***n(e.g. GET /fhir/AllergyIntolerance?patient=123)***REMOVED***n[X-OpenEhrCdr: <cdr-id>]

facade -> hapi : PIX lookup — read Patient,***REMOVED***nfind EHR ID for target CDR

facade -> openfhir : /toaql (templateId, ehrId, fhirPath)

openfhir --> facade : AQL(s)

facade -> cdr : execute AQL
cdr --> facade : archetype rows

facade -> openfhir : REST /tofhir (archetype rows)


openfhir --> facade : FHIR Bundle

facade --> consumer : FHIR searchset Bundle***REMOVED***n(filtered to requested resource type)

@enduml
